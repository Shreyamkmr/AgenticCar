<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a tachometer (270° arc, centre 54,57, radius 22) with the needle at 62 %,
  a red zone at the top end, and an amber spark for the "agentic" part.
  Everything stays inside the 66 dp safe zone of the 108 dp adaptive-icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dial track -->
    <path
        android:pathData="M38.444,72.556A22,22 0,1 1,69.556 72.556"
        android:strokeWidth="6"
        android:strokeColor="#2EFFFFFF"
        android:strokeLineCap="round" />

    <!-- Red zone -->
    <path
        android:pathData="M74.923,63.798A22,22 0,0 1,69.556 72.556"
        android:strokeWidth="6"
        android:strokeColor="#FFF43F5E"
        android:strokeLineCap="round" />

    <!-- Live reading -->
    <path
        android:pathData="M38.444,72.556A22,22 0,0 1,65.788 38.426"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="73"
                android:endX="66"
                android:endY="38"
                android:startColor="#FF2EE6A8"
                android:endColor="#FF38BDF8" />
        </aapt:attr>
    </path>

    <!-- Needle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56.2,58.39L63.64,41.8L51.8,55.61Z" />

    <!-- Hub -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,57m-5.2,0a5.2,5.2 0,1 1,10.4 0a5.2,5.2 0,1 1,-10.4 0" />
    <path
        android:fillColor="#FF0E2440"
        android:pathData="M54,57m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />

    <!-- Spark -->
    <path
        android:fillColor="#FFFBBF24"
        android:pathData="M74,29Q74,34 79,34Q74,34 74,39Q74,34 69,34Q74,34 74,29Z" />
    <path
        android:fillColor="#FFFBBF24"
        android:pathData="M81,40.5Q81,43 83.5,43Q81,43 81,45.5Q81,43 78.5,43Q81,43 81,40.5Z" />
</vector>
